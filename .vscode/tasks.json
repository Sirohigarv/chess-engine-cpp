{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Chess Engine",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "main.cpp", "board.cpp", "moves.cpp", "check.cpp", "notation.cpp",
        "-o", "chess.exe",
        "-I", "C:/Users/garvs/Downloads/SFML-3.1.0/include",
        "-L", "C:/Users/garvs/Downloads/SFML-3.1.0/lib",
        "-lsfml-graphics",
        "-lsfml-window",
        "-lsfml-system"
      ],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc-v2"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}